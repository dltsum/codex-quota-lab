<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.quotalab.agent</string>
    <key>ProgramArguments</key>
    <array>
      <string>/usr/local/bin/node</string>
      <string>/opt/codex-quota-lab/apps/agent/dist/cli.js</string>
      <string>daemon</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/opt/codex-quota-lab</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/quotalab-agent.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/quotalab-agent.err.log</string>
  </dict>
</plist>
