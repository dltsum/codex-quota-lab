{
  "name": "@quotalab/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.json --pretty false && vite build",
    "dev": "vite --host 127.0.0.1",
    "e2e:serve": "node e2e/server.mjs",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @quotalab/contracts build && pnpm build && pnpm --filter @quotalab/server build && playwright test",
    "typecheck": "tsc -b tsconfig.json --pretty false"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@quotalab/contracts": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  }
}
