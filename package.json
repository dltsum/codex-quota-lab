{
  "name": "codex-quota-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Private-by-default multi-device Codex quota observability and coordination.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm --parallel --filter @quotalab/server --filter @quotalab/web dev",
    "agent": "node apps/agent/dist/cli.js",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint . && pnpm format:check",
    "package:agent": "node scripts/build-agent.mjs",
    "start": "pnpm --filter @quotalab/server start",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:deploy": "node scripts/smoke-deployed-server.mjs",
    "test:e2e": "pnpm --filter @quotalab/web test:e2e",
    "typecheck": "tsc -b tsconfig.json --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "esbuild": "^0.25.9",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.42.0"
  }
}
